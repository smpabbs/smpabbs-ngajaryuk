# ── Serverless / Vercel ──────────────────────────────────
api/index.php
vercel.json
.vercelignore

# ── GitHub Database Sync ────────────────────────────────
config/github-db.php
app/Services/GitHubDatabaseService.php
app/Console/Commands/GitHubSyncDbCommand.php

# ── Environment ──────────────────────────────────────────
APP_NAME="Ngaji Yuk — SMP ABBS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smpabbs-ngajaryuk.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ── Database (SQLite via GitHub Sync) ────────────────────
DB_CONNECTION=sqlite
# DB_DATABASE is set automatically by api/index.php on Vercel
# For local: database/database.sqlite

# ── GitHub Token (required for Vercel deployment) ────────
GITHUB_TOKEN=
GITHUB_REPO_OWNER=smpabbs
GITHUB_REPO_NAME=smpabbs-ngajaryuk
GITHUB_REPO_BRANCH=main
GITHUB_DB_AUTO_SYNC=false

# ── Session ──────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# ── Cache ────────────────────────────────────────────────
CACHE_STORE=file

# ── Queue ────────────────────────────────────────────────
QUEUE_CONNECTION=sync

# ── Logging ──────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Mail ─────────────────────────────────────────────────
MAIL_MAILER=log

# ── Vite (build path for production) ─────────────────────
VITE_APP_NAME="${APP_NAME}"
